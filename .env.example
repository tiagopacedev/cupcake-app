# Copy to .env and fill in. Never commit the real .env (it's git-ignored).
# See docs/02-architecture.md §9 for what each variable is for.

# --- apps/api -----------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# CORS allow-list; the web app normally reaches the API through the
# same-origin /api rewrite, so this matters mainly outside that path.
WEB_ORIGIN=http://localhost:3000

# --- packages/database, apps/api (added in E2) --------------------------
# Local Docker Postgres (docker compose up -d db). DATABASE_URL (pooled in
# production, same local DB here) is used by both; DIRECT_URL is for the
# Prisma CLI only (migrations), not read by apps/api.
DATABASE_URL="postgresql://cupcake:cupcake@localhost:5432/cupcake_dev?sslmode=disable"
DIRECT_URL="postgresql://cupcake:cupcake@localhost:5432/cupcake_dev?sslmode=disable"

# --- apps/web -------------------------------------------------------------
# Server-only: target of the /api/* rewrite (next.config.ts) and of
# server-side fetches. Point at the local API during development.
API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
