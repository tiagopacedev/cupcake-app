{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build:dist": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.int.test.ts'",
    "test:coverage": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "database": "workspace:*",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "pino": "10.4.0",
    "shared": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
