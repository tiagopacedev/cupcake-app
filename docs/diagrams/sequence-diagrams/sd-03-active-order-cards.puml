@startuml sd-03-active-order-cards
!include ../_style.iuml
title SD-03 · Active-order cards on the home page (UC-04, BR-19) · endpoints per 07-api-spec
autonumber
actor Customer
participant "CatalogPage\n(View, SCR-01)" as V
participant "active-orders store\n(localStorage)" as LS
participant "orders.routes /\nOrderController" as C
participant "OrderService" as S
database "PostgreSQL" as DB

Customer -> V : open the store
activate V
V -> LS : read "cupcake.orders"
LS --> V : up to 5 { code, createdAt }, newest first
alt nothing stored
  V --> Customer : catalog without cards
else stored orders
  loop each stored code (requests in parallel)
    V -> C : GET /api/orders/{code}
    activate C
    C -> S : getByCode(code)
    S -> DB : expire overdue orders (BR-20),\nthen SELECT order + items WHERE code = $1
    DB --> S : row | none
    alt not found
      S --> C : ORDER_NOT_FOUND
      C --> V : 404
      V -> LS : remove this code
    else found
      S --> C : public order (first name only, BR-16)
      C --> V : 200 { code, pickupStatus, … }
      alt pickupStatus = AWAITING_PICKUP
        V --> Customer : card "Seu pedido · CUP-XXXXXX ·\nAguardando retirada" between header and filters
      else PICKED_UP or EXPIRED
        V -> LS : remove this code
      end
    end
    deactivate C
  end
end
alt network error on a code
  V --> Customer : no card for it; the code is kept (silent)
end
Customer -> V : tap a card
V --> Customer : navigate to /orders/{code} (Meu pedido) → UC-05
deactivate V
@enduml
