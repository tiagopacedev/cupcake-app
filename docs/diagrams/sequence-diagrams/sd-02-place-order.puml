@startuml sd-02-place-order
!include ../_style.iuml
title SD-02 · Place order (UC-03, includes UC-07) · endpoints per 07-api-spec
autonumber
actor Customer
participant "CheckoutPage\n(View, SCR-03)" as V
participant "cart store /\nactive-orders store\n(localStorage)" as LS
participant "orders.routes /\nOrderController" as C
participant "OrderExpiryService" as X
participant "OrderService" as S
participant "ProductRepository" as PR
participant "CustomerRepository" as CUR
participant "OrderRepository" as OR
database "PostgreSQL" as DB

Customer -> V : enter name + phone, tap "Fazer pedido"
activate V
V -> V : client validation (BR-14)
alt invalid fields
  V --> Customer : messages next to fields (alt A)
else valid
  V -> V : disable button, show "Enviando…"
  V -> C : POST /api/orders\n{ customer: {name, phone}, items: [{productId, quantity}] }
  activate C
  C -> C : shared schema: name 2..80, phone normalized to\n+55DD9XXXXXXXX (BR-14), unique productIds, quantity 1..20
  alt schema invalid
    C --> V : 400 VALIDATION_ERROR { fields }
    V --> Customer : field messages (alt A)
  else schema valid
    C -> S : create(input)
    activate S
    S -> X : expireOverdue()   (BR-20)
    X -> DB : overdue AWAITING_PICKUP orders → EXPIRED,\ntheir units back to stock (once)
    group transaction (BR-10, BR-11)
      S -> PR : findActiveByIds(productIds)
      PR -> DB : SELECT … FROM products WHERE id = ANY($1) AND is_active
      DB --> PR : rows
      alt some product missing / inactive
        S -> S : ROLLBACK
        S --> C : throw PRODUCT_NOT_FOUND
        C --> V : 409 PRODUCT_NOT_FOUND { productIds }
        V --> Customer : notice, back to cart (alt B)
      else all products found
        loop each item, ordered by productId (avoids deadlocks)
          S -> PR : decrementStock(productId, quantity)   (UC-07)
          PR -> DB : UPDATE products SET stock_quantity = stock_quantity - $q\nWHERE id = $id AND stock_quantity >= $q
          DB --> PR : rows affected (1 | 0)
        end
        alt any update affected 0 rows
          S -> PR : read current stock of affected products
          S -> S : ROLLBACK
          S --> C : throw INSUFFICIENT_STOCK
          C --> V : 409 INSUFFICIENT_STOCK\n{ items: [{productId, requested, available}] }
          V --> Customer : affected items, back to cart (alt C, US-19)
        else all decremented
          S -> CUR : upsertByPhone(name, phone)   (BR-15)
          CUR -> DB : INSERT … ON CONFLICT (phone)\nDO UPDATE SET name = $name
          S -> S : line totals + total from DB prices (BR-07, BR-08)
          S -> S : computePickup(store opening hours, now)\n→ readyAt, expiresAt (BR-12)
          S -> S : generate code CUP-XXXXXX (BR-13)
          S -> OR : create(order, readyAt, expiresAt,\nitems with unitPriceCents)
          OR -> DB : INSERT orders; INSERT order_items
          alt unique violation on code (rare)
            DB --> OR : error 23505
            OR --> S : retry the whole transaction with a new code (max 5)
          end
          S -> S : COMMIT
          S --> C : order
          deactivate S
          C --> V : 201 Order { code, pickupStatus, customerFirstName,\ncreatedAt, readyAt, expiresAt, items, totalCents }
          deactivate C
          V -> LS : clear the cart (BR-17)\nadd { code, createdAt } to the active orders (BR-19)
          V --> Customer : navigate to /orders/{code}?new=1\n(Meu pedido, SCR-04) → UC-05
        end
      end
    end
  end
end
alt network error / 5xx
  V --> Customer : error + retry, button re-enabled (alt E)
end
deactivate V
@enduml
