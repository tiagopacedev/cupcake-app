@startuml sd-04-view-order
!include ../_style.iuml
title SD-04 · View order (Meu pedido) / verify at pickup (UC-05, UC-06) · endpoints per 07-api-spec
autonumber
actor "Customer or\nStore staff" as Actor
participant "OrderPage\n(View, SCR-04)" as V
participant "orders.routes /\nOrderController" as C
participant "OrderService" as S
participant "OrderRepository" as OR
database "PostgreSQL" as DB

Actor -> V : open /orders/{code}\n(after checkout with ?new=1, from the home card, or typed)
activate V
V -> V : loading state
V -> C : GET /api/orders/{code}
activate C
C -> C : validate code format
C -> S : getPublicOrder(code)
activate S
S -> OR : findByCode(code)
OR -> DB : SELECT order, items (+product name, image), customer.name\nWHERE orders.code = $1
DB --> OR : row | none
alt not found
  S --> C : throw OrderNotFoundError
  C --> V : 404 ORDER_NOT_FOUND
  V --> Actor : "Pedido não encontrado" + "Voltar ao início" (alt A)
else found
  S -> S : firstName = first word of customer.name (BR-16)\nreadyAt = createdAt + 15 min (BR-12)\nphone is never included
  S --> C : public order view
  deactivate S
  C --> V : 200 Order { code, pickupStatus, customerFirstName,\ncreatedAt, readyAt, items, totalCents }
  deactivate C
  opt arrived from checkout (?new=1)
    V --> Actor : success notice "Pedido feito! Pronto em ~15 min."
  end
  V --> Actor : centered code + "Copiar código", first name · time · ready time,\nitems (photo, qty × unit price, line total), subtotal,\n"Total a pagar na loja", store address and hours
  opt Store staff (UC-06)
    Actor -> Actor : check items, collect payment at the counter,\nhand over (offline, BR-18)
  end
end
deactivate V
@enduml
