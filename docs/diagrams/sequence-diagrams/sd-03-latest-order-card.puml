@startuml sd-03-latest-order-card
!include ../_style.iuml
title SD-03 · Latest-order card on the home page (UC-04, BR-19) · endpoints per 07-api-spec
autonumber
actor Customer
participant "CatalogPage\n(View, SCR-01)" as V
participant "lastOrderStore\n(localStorage)" as LS
participant "orders.routes /\nOrderController" as C
participant "OrderService" as S
database "PostgreSQL" as DB

Customer -> V : open the store
activate V
V -> LS : read "cupcake.lastOrder"
LS --> V : { code, createdAt } | null
alt nothing stored, or createdAt is not today (America/Sao_Paulo)
  V --> Customer : catalog without the card
else stored order from today
  V -> C : GET /api/orders/{code}
  activate C
  C -> S : getPublicOrder(code)
  S -> DB : SELECT order + items WHERE code = $1
  DB --> S : row | none
  alt not found
    S --> C : OrderNotFoundError
    C --> V : 404 ORDER_NOT_FOUND
    V -> LS : remove "cupcake.lastOrder"
    V --> Customer : catalog without the card
  else found
    S --> C : public order (first name only, BR-16)
    deactivate C
    C --> V : 200 { code, pickupStatus, createdAt, … }
    alt pickupStatus = AWAITING_PICKUP
      V --> Customer : card "Seu pedido · CUP-XXXXXX ·\nAguardando retirada" between header and filters
    else other status (future: PICKED_UP)
      V --> Customer : catalog without the card
    end
  end
end
alt network error
  V --> Customer : catalog without the card (silent; the catalog still works)
end
Customer -> V : tap the card
V --> Customer : navigate to /orders/{code} (Meu pedido) → UC-05
deactivate V
@enduml
