@startuml ad-02-latest-order-card
!include ../_style.iuml
title AD-02 · Latest-order card decision on the home page (UC-04, BR-19)

|Web app (View)|
start
:Read "cupcake.lastOrder" from localStorage;
if (Stored order exists?) then (no)
  :Hide card;
  stop
else (yes)
endif
if (Created today (America/Sao_Paulo)?) then (no)
  :Hide card;
  stop
else (yes)
endif
:GET /api/orders/{code};
|API (Controller + Model)|
:Find order by code;
|Web app (View)|
if (Response?) then (404)
  :Remove stored code;
  :Hide card;
  stop
elseif () then (network error)
  :Hide card silently;
  stop
else (200)
endif
if (pickupStatus = AWAITING_PICKUP?) then (yes)
  :Show card "Seu pedido · code ·\nAguardando retirada" above the filters;
  note right
    Only the most recent order is kept.
    The card exists only in this browser
    (no account, BR-19).
  end note
else (no)
  :Hide card;
endif
stop
@enduml
