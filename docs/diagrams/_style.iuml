' Shared PlantUML style for Cupcake Store diagrams
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundCorner 10
skinparam ArrowColor #5B4A50
skinparam BorderColor #8C5B67
skinparam BackgroundColor #FFFFFF
skinparam ActorBorderColor #8C5B67
skinparam ActorBackgroundColor #FDE2E4
skinparam UsecaseBackgroundColor #FFF6F7
skinparam UsecaseBorderColor #B5485A
skinparam ClassBackgroundColor #FFF9FA
skinparam ClassBorderColor #B5485A
skinparam ClassHeaderBackgroundColor #FDE2E4
skinparam PackageBackgroundColor #FFFCFD
skinparam PackageBorderColor #8C5B67
skinparam NoteBackgroundColor #FFF1D6
skinparam NoteBorderColor #B07D1F
skinparam ParticipantBackgroundColor #FFF6F7
skinparam ParticipantBorderColor #B5485A
skinparam DatabaseBackgroundColor #E8F0F7
skinparam DatabaseBorderColor #3F6A8A
skinparam SequenceLifeLineBorderColor #B9A5AA
skinparam SequenceGroupBackgroundColor #FFF1F3
skinparam ActivityBackgroundColor #FFF6F7
skinparam ActivityBorderColor #B5485A
skinparam ActivityDiamondBackgroundColor #FFF1D6
skinparam ActivityDiamondBorderColor #B07D1F
skinparam SwimlaneTitleFontStyle bold
