@startuml use-case-diagram
!include ../_style.iuml
title Cupcake Store · General Use Case Diagram (UC-01…UC-07)
left to right direction

actor "Customer" as Customer
actor "Store staff" as Staff
actor "Store owner" as Owner #EEEEEE;line:999999

rectangle "Cupcake Store" {
  usecase "UC-01\nBrowse catalog" as UC01
  usecase "Filter by category\nor Bestsellers" as UCF
  usecase "UC-02\nManage cart" as UC02
  usecase "UC-03\nPlace order\n(name + phone,\npay at the store)" as UC03
  usecase "UC-07\nValidate and reserve\nstock" as UC07
  usecase "UC-04\nReopen an active order\n(home cards)" as UC04
  usecase "UC-05\nView order\n(Meu pedido)" as UC05
  usecase "Copy or share\norder code" as UCC
  usecase "UC-06\nVerify order, collect payment\nand mark as picked up" as UC06

  usecase "Manage catalog,\nstock and hours\n«future»" as UCX1 #F2F2F2;line:AAAAAA;text:888888
}

Customer --> UC01
Customer --> UC02
Customer --> UC03
Customer --> UC04
Customer --> UC05
Customer --> UC06

UCF .> UC01 : <<extend>>
UC03 .> UC07 : <<include>>
UC04 .> UC05 : <<include>>
UCC .> UC05 : <<extend>>
UC06 .> UC05 : <<include>>

UC06 <-- Staff
UCX1 <-- Owner

note right of UCX1
  Out of scope (PRD §4).
  The catalog is maintained by the
  seed script (US-21); the opening
  hours by the store config (BR-12).
end note
note right of UC03
  No online payment: the customer
  pays at the counter (BR-09).
end note
note right of UC06
  The handover is recorded through
  the staff API (BR-21), without UI.
  Payment is never recorded.
end note
@enduml
