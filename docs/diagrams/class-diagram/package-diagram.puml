@startuml package-diagram
!include ../_style.iuml
title Cupcake Store · MVC Package Diagram (logical architecture)
skinparam packageStyle rectangle

package "apps/web (Next.js) · VIEW" as WEB {
  package "pages (routes)" as WPages {
    [CatalogPage\nSCR-01] as P1
    [CartPage\nSCR-02] as P2
    [CheckoutPage\nSCR-03] as P3
    [OrderPage (Meu pedido)\nSCR-04] as P4
  }
  package "components" as WComp {
    [AppHeader, ActiveOrderCards,\nFilterChips, ProductCard, QuantityStepper,\nCartLine, OrderSummary, OrderCodeCard,\nPickupInfo, StoreFooter, Notice, EmptyState] as C1
  }
  package "lib" as WLib {
    [apiClient\n(typed from OpenAPI)] as AC
    [cart store, active-orders store\n(localStorage)] as CS
    [format (pt-BR, BRL,\nready time, deadline)] as FMT
  }
}

package "apps/api (Fastify)" as API {
  package "plugins" as PL {
    [requestId, security\n(helmet, cors, rate limit)] as PLS
    [staff-auth\n(bearer token, BR-21)] as SA
  }
  package "routes · ROUTER" as R {
    [catalog.routes] as R1
    [orders.routes] as R2
  }
  package "controllers · CONTROLLER" as CT {
    [CatalogController] as CC
    [OrderController] as OC
  }
  package "services · MODEL (business rules)" as SV {
    [CatalogService] as CSV
    [OrderService\n(create, getByCode,\nmarkPickedUp)] as OSV
    [OrderExpiryService\n(BR-20)] as XSV
    [stock rules, order code,\norder mapper] as UT
  }
  package "repositories · MODEL (persistence)" as RP {
    [ProductRepository] as PR
    [CategoryRepository /\nTagRepository] as CR
    [CustomerRepository] as CUR
    [OrderRepository] as OR
  }
  [errors\n(AppError + global handler)] as ERR
}

package "packages/database" as DBP {
  [Prisma schema\n+ migrations + seed] as PS
}

package "packages/shared" as SH {
  [zod order schema (BR-14), phone utils,\nerror codes, STORE config,\ncomputePickup (BR-12)] as SHV
}

database "PostgreSQL" as PG

WPages ..> WComp
WPages ..> WLib
AC ..> R : HTTPS / JSON
R1 ..> CC
R2 ..> OC
R2 ..> SA : PATCH …/pickup
CC ..> CSV
OC ..> OSV
CSV ..> XSV
OSV ..> XSV
OSV ..> UT
CSV ..> PR
CSV ..> CR
OSV ..> CUR
OSV ..> OR
XSV ..> OR
XSV ..> PR
RP ..> PS : Prisma Client
PS ..> PG
CT ..> ERR
SV ..> ERR
WEB ..> SH
API ..> SH

note right of CT
  Controllers: validate input, call one
  service, map result/error to HTTP.
  No business logic, no database access.
end note
note right of SV
  Services hold BR-01…BR-21.
  Order creation (stock decrement +
  order insert) runs in one transaction;
  overdue orders are expired first.
end note
@enduml
